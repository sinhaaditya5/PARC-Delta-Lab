  "open_questions": [
    {
      "topic": "Collision closure",
      "question": "Why do TA/Nanbu still miss 6–7% of the Rosenbluth alpha energy loss at 32 substeps, and does importance sampling of near-comoving electrons close it?"
    },
    {
      "topic": "Trapped-alpha accumulation",
      "question": "An on-axis foil re-intersects ~38% of trapped alphas within 4 µs. Pulsed or retractable targets, or a gas/pellet boron target, are needed to build a trapped population."
    },
    {
      "topic": "Alpha drive",
      "question": "Fusion alphas from a µA beam are ~10⁹× too sparse for IBW self-excitation. What surrogate energetic-ion source reaches n_fast/n_p ≈ 1% at bench scale?"
    },
    {
      "topic": "Coherent vs irreversible",
      "question": "How will PDX-1 separate coherent proton response from irreversible proton heating (Gate 4)? Candidate: RFEA/CX energy distributions with RF on/off modulation."
    },
    {
      "topic": "Nonlinear physics",
      "question": "Does the multi-mode advantage survive nonlinear saturation and mode coupling? Requires a PIC benchmark (Gate 3) before any control-law claim."
    },
    {
      "topic": "Magnet engineering",
      "question": "REBCO mirror coils see ~10 T and a ~170 MPa J×B×R screen; quench protection, structure and cost need FEA and vendor input."
    },
    {
      "topic": "Bench electron dominance",
      "question": "At Te = 10 eV, 99.9% of alpha energy goes to electrons. Which bench parameters make the α→p channel measurable against this baseline?"
    },
    {
      "topic": "Source validation",
      "question": "Can the Si spectrometer resolve the α0/α1 branch structure to validate the sequential-kinematic source (an open Gate 2 item)?"
    },
    {
      "topic": "Radiation safety",
      "question": "Alphas striking boron produce neutrons via ¹¹B(α,n)¹⁴N; shielding and licensing need a dose assessment even at µA currents."
    },
    {
      "topic": "Foil survival",
      "question": "≤6.75 W of beam power on a 1 µm foil: thermal survival, sputtering and 11B enrichment supply need testing."
    }
